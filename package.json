{
  "name": "storyscribe-ai",
  "version": "0.1.0",
  "description": "A proof-of-concept that uses Whisper for video transcription, passes the transcript to Ollama to generate a well-formatted Markdown summary, and then converts the summary into a PDF document.",
  "keywords": [
    "whisper",
    "ollama",
    "openai"
  ],
  "homepage": "https://github.com/karoldydo/storyscribe-ai#readme",
  "bugs": {
    "url": "https://github.com/karoldydo/storyscribe-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karoldydo/storyscribe-ai.git"
  },
  "license": "MIT",
  "author": {
    "name": "Karol Dydo",
    "url": "https://karoldydo.dev"
  },
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "packages": "packages"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "client:build": "yarn workspace @storyscribe-ai/client build",
    "client:lint": "yarn workspace @storyscribe-ai/client lint",
    "client:prettier": "yarn workspace @storyscribe-ai/client prettier",
    "client:start": "yarn workspace @storyscribe-ai/client start",
    "client:test": "yarn workspace @storyscribe-ai/client test",
    "console:build": "yarn workspace @storyscribe-ai/console build",
    "console:lint": "yarn workspace @storyscribe-ai/console lint",
    "console:prettier": "yarn workspace @storyscribe-ai/console prettier",
    "console:start": "yarn workspace @storyscribe-ai/console start",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-perfectionist": "^4.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-packagejson": "^2.5.14",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "yarn@4.9.1"
}
