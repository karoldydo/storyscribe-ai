{
  "name": "@storyscribe-ai/console",
  "version": "0.1.0",
  "description": "A proof-of-concept that uses Whisper for video transcription, passes the transcript to Ollama to generate a well-formatted Markdown summary, and then converts the summary into a PDF document.",
  "keywords": [
    "whisper",
    "ollama",
    "openai"
  ],
  "homepage": "https://github.com/karoldydo/storyscribe-ai#readme",
  "bugs": {
    "url": "https://github.com/karoldydo/storyscribe-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karoldydo/storyscribe-ai.git"
  },
  "license": "MIT",
  "author": {
    "name": "Karol Dydo",
    "url": "https://karoldydo.dev"
  },
  "type": "module",
  "main": "../../dist/console/index.js",
  "scripts": {
    "build": "tsup",
    "lint": "eslint --config eslint.config.mjs --fix",
    "prettier": "prettier --write . --cache --cache-location=../../node_modules/.cache/prettier",
    "start": "tsup && node ../../dist/console/index.js",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "csso": "^5.0.5",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.21"
  },
  "devDependencies": {
    "@types/csso": "^5.0.4"
  },
  "packageManager": "yarn@4.9.1"
}
