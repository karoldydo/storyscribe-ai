{
  "name": "@storyscribe-ai/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "lint": "eslint --config ./eslint.config.mjs --fix",
    "prettier": "prettier --write . --cache --cache-location=../../node_modules/.cache/console/prettier",
    "start": "tsup && node ../../dist/console/index.js",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "csso": "^5.0.5",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/csso": "^5.0.4"
  },
  "packageManager": "yarn@4.9.1"
}
